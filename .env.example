# ══════════════════════════════════════════════════════════════════════════════
#  NeXoNetwork Server — Variables de entorno
#  Copia este archivo como .env y rellena tus valores:
#    cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# "production" desactiva los logs verbose de Fastify
NODE_ENV=development

# ── Dominio base ──────────────────────────────────────────────────────────────
# El servidor detecta el módulo a usar por el header Host de cada petición.
# Pon aquí tu dominio real (sin https://, sin slash final).
# Ejemplo producción:  nexonetwork.space
# Ejemplo local:       localhost
BASE_DOMAIN=nexonetwork.space

# ── HTTPS (para Switch real con Atmosphere) ───────────────────────────────────
# La Switch verifica certificados SSL. Activa esto después de generar los certs:
#   ./scripts/gen-certs.sh
# Los certificados se guardan en /certs/ (ignorado por git).
NEXO_HTTPS=false

# ── Base de datos MySQL ───────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nexo
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=nexo_network

# Número de conexiones simultáneas al pool de MySQL.
# 10 es suficiente para desarrollo. Sube a 20-50 en producción con muchos usuarios.
DB_POOL_SIZE=10

# ── JWT ───────────────────────────────────────────────────────────────────────
# IMPORTANTE: Cambia JWT_SECRET por una cadena larga y aleatoria en producción.
# Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=nexo_dev_secret_CHANGE_IN_PRODUCTION

# Tiempo de vida del access token (token de sesión corta)
JWT_ACCESS_EXPIRES=15m

# Tiempo de vida del refresh token (para renovar el access token sin re-login)
JWT_REFRESH_EXPIRES=30d

# ── Seguridad ─────────────────────────────────────────────────────────────────
# Rondas de bcrypt para hashear contraseñas.
# 10 es el mínimo seguro. Más rondas = más lento pero más seguro (máx recomendado: 12).
BCRYPT_ROUNDS=10

# ── Contenido ─────────────────────────────────────────────────────────────────
# Mensaje del día — aparece en /api/v1/server/info y en el emulador al conectar.
MOTD=Bienvenido a NeXoNetwork — Open Switch Online.

# ── NEX TCP Servers ────────────────────────────────────────────────────────────
# Switch games connect via raw TCP (PRUDP protocol), NOT WebSocket.
# These ports must be open in your firewall and forwarded if behind NAT.
# The game's auth ticket tells it to connect to these ports.

# MK8 NEX TCP port (default: 29900)
NEXO_MK8_TCP_PORT=29900

# SMM2 NEX TCP port (default: 29901)
NEXO_SMM2_TCP_PORT=29901

# The public IP or domain that the game uses to connect to NEX.
# For local testing: 127.0.0.1
# For production: your server's public IP (e.g. 203.0.113.5)
NEXO_TCP_HOST=127.0.0.1

# ── NEX Go — Auth server (Mario Kart 8 Deluxe) ────────────────────────────────
# Servidor Go independiente (nex-server/cmd/mk8-auth) que emite tickets NEX
# reales (Kerberos) sobre UDP, en vez del ticket hardcodeado con clave cero
# que servía antes mk8/nex_tcp.js. Ver nex-server/README.md.

# Puerto UDP donde escucha el auth server. Necesita regla de firewall directa
# (Nginx no proxea UDP) — VERIFICAR contra el puerto real que MK8D intenta usar.
NEXO_MK8_AUTH_UDP_PORT=60000

# AccessKey NEX de Mario Kart 8 Deluxe (Switch). Firma los paquetes PRUDP.
# NO CONFIRMADO — hay que extraerlo por ingeniería inversa del binario de
# MK8D o de una base de datos de la comunidad NEX. Sin el valor correcto,
# el juego real rechazará los paquetes silenciosamente. Obligatorio: el
# servidor no arranca si esto está vacío.
NEXO_MK8_ACCESS_KEY=

# Versión de librería NEX que negocia MK8D (major.minor.patch). 4.0.0 es un
# valor razonable para un título de Switch (NEX 4+, confirmado por el código:
# usa el método ValidateAndRequestTicketWithParam, propio de NEX>=4.0.0) pero
# NO CONFIRMADO contra el juego real — verificar antes de probar en hardware.
NEXO_MK8_NEX_VERSION=4.0.0

# Password de la cuenta especial que representa el servidor "secure" de MK8
# (hoy: mk8/nex_tcp.js — ver caveat de transporte en nex-server/README.md).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Obligatorio: el servidor no arranca si esto está vacío.
NEXO_MK8_SECURE_PASSWORD=

# ── NEX Go — Secure server (Mario Kart 8 Deluxe) ──────────────────────────────
# Servidor Go (nex-server/cmd/mk8-secure) al que conecta la Switch DESPUÉS de
# obtener el ticket del auth server. Valida el ticket Kerberos y sirve el juego
# (SecureConnection + Matchmaking). UDP — abrir en el firewall.
NEXO_MK8_SECURE_UDP_PORT=60001

# ── PostgreSQL — SOLO para el matchmaking del secure server ────────────────────
# La matchmaking común de Pretendo usa Postgres (crea sola los esquemas
# matchmaking.* y tracking.*). Es una base SEPARADA de tu MySQL de cuentas.
# Crea la base vacía: CREATE DATABASE nexo_matchmaking;
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=nexo
PG_PASSWORD=
PG_NAME=nexo_matchmaking
PG_SSLMODE=disable

# ── Sistema de actualización (panel admin) ────────────────────────────────────
# El botón "Actualizar" del panel admin (POST /admin/system/update) no necesita
# ninguna variable de entorno — solo requiere que tu cuenta tenga is_admin=1.
# Hace git fetch + git reset --hard sobre el remoto ya configurado en el
# checkout del servidor (ver scripts/update.sh).
